# URL pública de canchaYa-API para el entorno real (Vercel).
# Expo expone al bundle SOLO las variables con prefijo EXPO_PUBLIC_; no pongas secretos aquí.
#
# Configura este valor en .env (desarrollo) o en las variables de entorno del
# proyecto de EAS (builds). No quemes la URL dentro del código.
EXPO_PUBLIC_API_URL=https://tu-api.vercel.app
