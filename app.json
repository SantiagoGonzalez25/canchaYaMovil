{
  "expo": {
    "name": "CanchaYa",
    "slug": "canchaya-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "canchaya",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.tdea.canchaya",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tdea.canchaya",
      "adaptiveIcon": {
        "backgroundColor": "#00652e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00652e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CanchaYa usa la cámara para tomar una foto de portada de un ACUDE.",
          "photosPermission": "CanchaYa accede a tus fotos solo cuando eliges una portada.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6fb46e25-3a52-46e4-bd40-c65612105f71"
      }
    },
    "owner": "santiagores"
  }
}
